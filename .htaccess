# ============================================================

# CBT-HERO

# Root Web Entry Point

# ============================================================

DirectoryIndex index.php

Options -Indexes

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# ============================================================

# PROTECT SENSITIVE FILES

# ============================================================

<FilesMatch "(?i)^(?:\.env(?:\..*)?|env|composer\.(?:json|lock)|spark|preload\.php|phpunit(?:\.dist)?\.xml)$">
    Require all denied
</FilesMatch>

# ============================================================

# URL REWRITE

# ============================================================

<IfModule mod_rewrite.c>

    RewriteEngine On

    # --------------------------------------------------------
    # Protect internal CBT-HERO directories
    # --------------------------------------------------------

    RewriteRule ^(?:\.git|\.github)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:app|vendor|writable|tests|docs)(?:/|$) - [F,L,NC]

    # --------------------------------------------------------
    # Preserve Authorization header
    # --------------------------------------------------------

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # --------------------------------------------------------
    # Remove trailing slash when target is not a directory
    # --------------------------------------------------------

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # --------------------------------------------------------
    # Send non-existing files/directories to CI4
    # --------------------------------------------------------

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

</IfModule>

# ============================================================

# SERVER

# ============================================================

ServerSignature Off
