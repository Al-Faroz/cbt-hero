#-------------------------
_modules/*
.php-version
.idea/
*.iml
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme
*.sublime-workspace
*.sublime-project
.phpintel
/api/
.vscode/
/results/
phpunit.xml
